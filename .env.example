# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.

# Google Gemini API key, for the object-listing and mask-verdict stages.
# Get one from Google AI Studio. NOTE: those stages upload your photograph to
# Google's API — read Google's terms before using photos you would not
# otherwise share.
GEMINI_API_KEY=

# Hugging Face token, for the gated Meta SAM 3 segmentation weights
# (facebook/sam3). You must accept the SAM License on the model page first.
HF_TOKEN=

# Your checkout of Meta's SAM-3D-Objects release — the directory containing
# checkpoints/hf/pipeline.yaml. Required by the GPU reconstruction tier only.
SAM3D_OBJECTS_ROOT=

# A Python interpreter with `usd-core` installed, for the USD exporter. Only
# needed when `import pxr` fails in the interpreter running the pipeline.
LENS_PXR_PYTHON=

# Optional, GPU tests only. An indoor photograph to run segmentation against.
LENS_DEMO_PHOTO=
